# Textbook-style function plots (figures 5-1, 6-1, 6-2)
#
# Scope it to one figure so it doesn't leak into later cells:
#
#     with plt.style.context("styles/function_plot.mplstyle"):
#         ...
#         plt.show()

font.family:        sans-serif
font.sans-serif:    Helvetica, Arial, DejaVu Sans
font.size:          22.5
mathtext.fontset:   custom
mathtext.rm:        sans
mathtext.it:        sans
mathtext.cal:       sans
axes.unicode_minus: False

axes.facecolor:     none
axes.linewidth:     1.1
axes.spines.top:    False
axes.spines.right:  False
axes.prop_cycle:    cycler('color', ['black'])

lines.linewidth:    1.45
lines.markersize:   14.8

xtick.direction:    out
ytick.direction:    out
xtick.major.size:   8.6
ytick.major.size:   8.6
xtick.major.width:  1.1
ytick.major.width:  1.1
xtick.major.pad:    14.8
ytick.major.pad:    10.4
